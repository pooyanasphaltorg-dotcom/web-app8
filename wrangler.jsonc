{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app8",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6c414657-eebf-4b4c-8915-310b4609b9cc","database_name": "web-app8" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a08ea2fd92ce4691a371173e6cc22c94" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
